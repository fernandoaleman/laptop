.DEFAULT_GOAL := check
.PHONY: setup lint format-check test check

setup:
	@set -eu; \
	set --; \
	for pair in prek:prek shellcheck:shellcheck shfmt:shfmt typos:typos-cli actionlint:actionlint; do \
		tool=$${pair%%:*}; formula=$${pair#*:}; \
		if command -v "$$tool" >/dev/null 2>&1; then \
			printf 'Available: %s\n' "$$tool"; \
		else \
			printf 'Missing: %s (Homebrew formula: %s)\n' "$$tool" "$$formula"; \
			set -- "$$@" "$$formula"; \
		fi; \
	done; \
	if command -v committed >/dev/null 2>&1; then \
		printf '%s\n' 'Available: committed'; \
	else \
		printf '%s\n' 'Missing: committed (provided by the prek-managed hook)'; \
	fi; \
	hooks_dir=$$(git rev-parse --git-path hooks); \
	for hook in pre-commit commit-msg; do \
		path="$$hooks_dir/$$hook"; \
		if [ -L "$$path" ] || { [ -e "$$path" ] && ! grep -Fqx '# File generated by prek: https://github.com/j178/prek' "$$path"; }; then \
			printf 'Existing non-prek hook preserved: %s; resolve it before setup.\n' "$$path" >&2; exit 1; \
		fi; \
	done; \
	if [ "$$#" -gt 0 ]; then \
		command -v brew >/dev/null 2>&1 || { printf '%s\n' 'Homebrew is required to install missing tools.' >&2; exit 1; }; \
		env HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_INSTALL_CLEANUP=1 HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1 HOMEBREW_NO_INSTALL_UPGRADE=1 brew install --formula "$$@"; \
	fi; \
	for tool in prek shellcheck shfmt typos actionlint; do \
		command -v "$$tool" >/dev/null 2>&1 || { printf 'Tool not found on PATH after setup: %s\n' "$$tool" >&2; exit 1; }; \
	done; \
	for hook in pre-commit commit-msg; do \
		if [ -e "$$hooks_dir/$$hook" ]; then \
			printf 'Already installed: %s\n' "$$hook"; \
		else \
			prek install --hook-type "$$hook"; \
		fi; \
	done

lint:
	shellcheck -s bash laptop install.sh tests/bootstrap.sh

format-check:
	shfmt -d -i 2 laptop install.sh tests/bootstrap.sh

test:
	bash -n laptop
	bash -n install.sh
	bash -n tests/bootstrap.sh
	bash tests/bootstrap.sh

check: lint format-check test
	typos
	actionlint .github/workflows/ci.yaml
